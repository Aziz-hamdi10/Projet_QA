        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"API Blue\", \"hexCode\": \"#0000FF\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Color contract\", () => { const b=pm.response.json(); pm.expect(b.hexCode).to.eql(\"#0000FF\"); pm.expect(b._id).to.match(/^[a-f0-9]{24}$/i); }); pm.collectionVariables.set(\"color_id\",pm.response.json()._id);"
            ]
          }
        }
      ]
    },
