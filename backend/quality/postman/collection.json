          }
        ],
        "url": "{{base_url}}/promotion/addpromotion",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"API promo\", \"percentage\": 10}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Promotion contract\", () => { const b=pm.response.json(); pm.expect(b.title).to.eql(\"API promo\"); pm.expect(b.codepromo).to.match(/^\\d{6}$/); pm.expect(b.percentage).to.eql(10); }); pm.collectionVariables.set(\"promo_id\",pm.response.json()._id);"
            ]
          }
        }
      ]
    },
