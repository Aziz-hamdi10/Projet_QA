              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "pm.test(\"Color ID and value\", () => { const b=pm.response.json(); pm.expect(b._id).to.eql(pm.collectionVariables.get(\"color_id\")); pm.expect(b.hexCode).to.eql(\"#0000FF\"); });"
            ]
          }
        }
      ]
